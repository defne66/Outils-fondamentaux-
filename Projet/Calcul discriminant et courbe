import math
import matplotlib.pyplot as plt
import numpy as np


a = float(input("Entrez la valeur de a : "))
b = float(input("Entrez la valeur de b : "))
c = float(input("Entrez la valeur de c : "))

if a == 0:
    print(
        "Attention : 'a' vaut 0, ce n'est plus un polynôme du second degré (c'est"
        " une droite) !"
    )
    if b != 0:
        print(f"Racine unique : x = {-c / b}")
    else:
        print("Pas de solution ou infinité de solutions.")
else:
    print(f"\n--- Étude du polynôme : {a}x² + ({b})x + ({c}) ---")

    delta = b**2 - 4 * a * c
    print(f"Discriminant (Delta) = {delta}")


    if delta > 0:
        x1 = (-b - math.sqrt(delta)) / (2 * a)
        x2 = (-b + math.sqrt(delta)) / (2 * a)
        print(f"Deux racines distinctes : x1 = {x1} et x2 = {x2}")
    elif delta == 0:
        x0 = -b / (2 * a)
        print(f"Une racine double : x0 = {x0}")
    else:
        print("Pas de racine réelle.")


    xv = -b / (2 * a)
    yv = a * xv**2 + b * xv + c
    print(f"Sommet de la parabole : S({xv}, {yv})")


    plt.figure(figsize=(8, 6))
    x = np.linspace(xv - 10, xv + 10, 400)
    y = a * x**2 + b * x + c

    plt.plot(x, y, label=f"{a}x² + {b}x + {c}", color="blue")
    plt.scatter([xv], [yv], color="red", zorder=5, label=f"Sommet ({xv}, {yv})")

    plt.axhline(0, color="black", linewidth=1, linestyle="--")
    plt.axvline(0, color="black", linewidth=1, linestyle="--")
    plt.title("Courbe du polynôme du second degré et son sommet")
    plt.xlabel("x")
    plt.ylabel("y")
    plt.grid(True)
    plt.legend()
    plt.show()
